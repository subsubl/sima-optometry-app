{
  "name": "sima-optometry-app",
  "version": "1.0.1",
  "description": "SIMA Optometry App — Clinical Digital Visual Acuity & Optometric Examination Console",
  "author": "SIMA Optometry <info@sima-optometry.org>",
  "homepage": "https://github.com/subsubl/sima-optometry-app",
  "desktopName": "sima-optometry-app.desktop",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && node server/index.mjs",
    "electron:dev": "ELECTRON_DEV=1 node server/dev.mjs",
    "electron:start": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.sima.optometry",
    "productName": "SIMA Optometry App",
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "Science",
      "executableName": "sima-optometry-app",
      "syncDesktopName": true,
      "synopsis": "Clinical Digital Visual Acuity & Optometric Examination Console",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "category": "public.app-category.medical",
      "target": "dmg"
    }
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@electron/asar": "^4.3.1",
    "@electron/get": "^5.1.0",
    "minimatch": "^11.0.5",
    "rimraf": "^6.1.4",
    "glob": "^14.0.4"
  }
}
